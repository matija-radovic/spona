# --- Frontend location ---
SPONA_FRONTEND_URL=http://localhost:5173

SPONA_PORT=8080
SPONA_LOG_LEVEL=DEBUG


# --- Sessions ---
SPONA_JWT_SECRET=dev-only-secret-change-me-at-least-32-bytes
SPONA_JWT_TTL=7d


# --- Database ---
SPONA_DB_URL=jdbc:postgresql://postgres:5432/spona
SPONA_DB_USER=spona
SPONA_DB_PASSWORD=spona


# --- Object storage ---
SPONA_S3_ENDPOINT=http://localhost:9000
SPONA_S3_PUBLIC_ENDPOINT=http://localhost:9000
SPONA_S3_ACCESS_KEY=spona
SPONA_S3_SECRET_KEY=spona-secret
SPONA_S3_REGION=us-east-1

SPONA_S3_PATH_STYLE=true
SPONA_S3_AVATAR_BUCKET=spona-avatars
SPONA_S3_CV_BUCKET=spona-cvs


# --- Mail ---
SPONA_MAIL_HOST=localhost
SPONA_MAIL_PORT=1025
SPONA_MAIL_USERNAME=
SPONA_MAIL_PASSWORD=
SPONA_MAIL_FROM=no-reply@spona.local

# For Gmail, run with the `smtp-tls` profile and set:
#   SPONA_MAIL_HOST=smtp.gmail.com
#   SPONA_MAIL_PORT=587
#   SPONA_MAIL_USERNAME=you@gmail.com
#   SPONA_MAIL_PASSWORD=<16-char App Password, not login password>
#   SPONA_MAIL_FROM=you@gmail.com
